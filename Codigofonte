#Pega a imagem presente no dirétorio selecionado e deixa do tamanho apropriado para exebição na janela
def carregar_e_ampliar(caminho):
    img_pil = Image.open(caminho)
    img_pil = img_pil.resize(TAMANHO_EXIBICAO, resample=Image.Resampling.NEAREST)
    return ImageTk.PhotoImage(img_pil)

#Abre o Seletor de arquivos e pega informações do arquivo selecionado
def explorar_arquivos():
