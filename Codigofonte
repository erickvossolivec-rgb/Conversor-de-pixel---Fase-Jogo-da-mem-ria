#Tranforma posição matricial em ordinal
        
def posled(i,j,W,H):
    O = orientation.get()
    Alterna = alterna.get()
    if Alterna == True:
        if O == orient[0]:
            if j%2 == 0:
                return(W*j+i)
            else:
                return(W*j+(W-1-i))
        if O == orient[1]:
            if j%2 ==0:
                return(W*j+(W-1-i))
            else:
                return(W*j+i)
        if O == orient[2]:
            if j%2 ==0:
                return(((H-1-j)*W+i))
            else:
                return((H-1-j)*W+(W-1-i))
        if O == orient[3]:
            if j%2 !=0:
                return((H-1-j)*W+i)
            else:
                return((H-1-j)*W+(W-1-i))            
    if Alterna == False:
        if O == orient[0]:
            return(W*j+i)
        if O == orient[1]:
            return(W*j+W-1-i)
        if O == orient[2]:
            return(((H-1-j)*W+i))
        if O == orient[3]:
            return((H-1-j)*W+(W-1-i))  
        
                

#Mede a distância de valor de cor entre duas cores
def distrgb(rgb,jkl):
    r,g,b = rgb
    j,k,l = jkl
    dist = math.sqrt((r - j)**2 + (g - k)**2 + (b - l)**2)
    return(dist)

#Caso na imagem haja pixels de cores não definidas pelo código, pegará a cor mais próxima das disponíveis
def definidordecor(rgb):
    distancias = []
    #Guarda as distâncias correspondo o indice da cor comparada, através do mínimo valor nesse vetor encontramos a cor mais próxima correspondente a esse índice
    for i in range(len(cores_char)):
        distancias.append(distrgb(rgb,cores_rgb[i]))
    indx = distancias.index(min(distancias))
    return(cores_char[indx])

#Converte a imagem selecionada em código utilizável para o Jogo da memória
def imglvl():
    global imagefile, img, img_container
    im = Image.open(imagefile).convert('RGB') #Converte imagem em valores de RGB extraíveis
    imageSizeW, imageSizeH = im.size #Extraí tamanho da imagem
    pixelnaopreto =[]
    #Extrai informação de cor de posição de pixels não pretos (que seriam desligados) e guarda em um array, o qual será printado na janela para copiar e colar no código
    for i in range(0, imageSizeW):
        for j in range(0, imageSizeH):
            pixVal = im.getpixel((i, j)) #Pega cor do pixel na posição i,j
            if pixVal != (0, 0, 0): #Se o pixel não for preto
                pixelnaopreto.append([posled(i,j,imageSizeW,imageSizeH), definidordecor(pixVal)])
                #Converte a posição em posição sequencial e a cor na cor mais próxima utilizada e guarda na lista de pixels a serem ligados nos leds
    
    A = (imageSizeW * imageSizeH)
    Limite = 255
    x = 0
    while A >= Limite:
        Limite = (2**(8+2*x))-1
        x= x+1

#Traduz para C
    pixelnaopreto.sort()
    pixelnaopreto.append([Limite,'X'])
    
    elementos = str(pixelnaopreto).replace("[","{")
    elementos = elementos.replace("]","}")
   
#Exibe as informações do pixel na janela
    pixels.config(state="normal")
    pixels.delete("1.0", tk.END) 
